---
import Icon from "./Icon.astro";
interface Props { current: number; last: number; base: string }
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
// janela de páginas: 1 … c-1 c c+1 … last
const nums = [...new Set([1, current - 1, current, current + 1, last])].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);
---
{last > 1 && (
  <nav class="pager" aria-label="Paginação">
    {current > 1 && <a href={href(current - 1)} aria-label="Página anterior"><Icon name="chevron-left" size={16} /></a>}
    {nums.map((n, i) => (
      <>
        {i > 0 && n - nums[i - 1] > 1 && <span class="dots">…</span>}
        {n === current ? <span class="cur" aria-current="page">{n}</span> : <a href={href(n)}>{n}</a>}
      </>
    ))}
    {current < last && <a href={href(current + 1)} aria-label="Próxima página"><Icon name="chevron-right" size={16} /></a>}
  </nav>
)}

<style>
  .pager { display: flex; justify-content: center; align-items: center; gap: 8px; margin-top: 56px; flex-wrap: wrap; }
  .pager a, .pager span { min-width: 42px; height: 42px; display: inline-grid; place-items: center; border-radius: 4px; padding: 0 10px; font-size: 16px; }
  .pager a { color: var(--vt-text); background: var(--vt-surface); }
  .pager a:hover { background: var(--vt-blue); color: var(--vt-white); text-decoration: none; }
  .cur { background: var(--vt-blue); color: var(--vt-white); }
  .dots { color: var(--vt-muted); }
</style>
