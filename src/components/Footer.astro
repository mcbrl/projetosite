---
import Icon from "./Icon.astro";
import HubSpotForm from "./HubSpotForm.astro";
import { footerNav, hubspot, site } from "../data/site";
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container cols">
    <div class="brand">
      <a href="/" aria-label={site.name}><img src={site.logo.dark} alt={site.name} width="214" height="78" loading="lazy" /></a>
      <ul class="social">
        {site.social.map((s) => (
          <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.name}><Icon name={s.icon} size={14} /></a></li>
        ))}
      </ul>
    </div>

    <nav aria-labelledby="f-quick">
      <h2 id="f-quick" class="f-title">Acesso Rápido</h2>
      <ul class="links">
        {footerNav.map((l) => <li><a href={l.href}><Icon name="chevron-right" size={14} />{l.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <h2 class="f-title">Onde Estamos</h2>
      <p class="address"><Icon name="pin" size={14} /><span>{site.address}</span></p>
    </div>

    <div class="newsletter">
      <h2 class="f-title">Newsletter</h2>
      <HubSpotForm formId={hubspot.forms.newsletter} dark square />
    </div>
  </div>

  <div class="container bottom">
    <p>Copyright © {year} Vertigo - Todos os direitos reservados.</p>
    <a class="credits" href={site.credits.href} target="_blank" rel="noopener">
      {site.credits.label} <img src={site.credits.logo} alt="Mov4" width="54" height="14" loading="lazy" />
    </a>
  </div>
</footer>

<style>
  .site-footer { background: var(--vt-ink); color: var(--vt-white); padding: 64px 0 0; }
  .cols { display: grid; grid-template-columns: 1.1fr 1fr 1.5fr 1fr; gap: 40px; padding-bottom: 56px; }
  .brand { display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .brand img { width: 214px; }
  .social { display: flex; gap: 6px; list-style: none; padding: 0; margin: 0; }
  .social a { width: 30px; height: 30px; border-radius: 50%; background: var(--vt-white); color: var(--vt-blue); display: grid; place-items: center; transition: transform .3s; }
  .social a:hover { transform: translateY(-8px); } /* elementor-animation-float */
  .f-title { font-size: var(--fs-h4); font-weight: 500; line-height: 1.4; letter-spacing: 0; margin: 0 0 20px; }
  .links { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .links a, .address { color: var(--vt-white); display: flex; gap: 10px; align-items: center; font-size: var(--fs-text); }
  .address { align-items: flex-start; }
  .address :global(svg) { margin-top: 5px; flex: none; }
  .bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; border-top: 1px solid #ffffff40; padding-top: 28px; padding-bottom: 28px; font-size: 13px; line-height: 1.5; }
  @media (max-width: 767px) { .bottom { font-size: 12px; } }
  .bottom p { margin: 0; }
  .credits { color: var(--vt-white); display: inline-flex; align-items: center; gap: 6px; }
  .credits img { width: 54px; }
  @media (max-width: 1024px) { .cols { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) {
    .cols { grid-template-columns: 1fr; text-align: left; }
    .brand { align-items: flex-start; }
    .bottom { flex-direction: column; text-align: center; }
  }
</style>
