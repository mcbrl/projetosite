---
// Card de case/ebook. Reproduz o flip box do Elementor (efeito "slide", direção "down"):
// no hover/foco, a camada escura com a descrição e o botão desce sobre a frente em .6s.
import type { Material } from "../lib/materiais";
import { langOf } from "../lib/i18n";
interface Props { item: Material }
const { item } = Astro.props;
const more = langOf(Astro.url) === "en" ? "Read more" : "Saiba mais";
---
<a class="case" href={item.href} target={item.external ? "_blank" : undefined} rel={item.external ? "noopener" : undefined} data-cats={item.categories.join(" ")}>
  <span class="front">
    {item.image && <img src={item.image} alt="" loading="lazy" width="847" height="1024" />}
    <span class="title">{item.title}</span>
  </span>
  <span class="back" aria-hidden="true">
    {item.image && <img src={item.image} alt="" loading="lazy" width="847" height="1024" />}
    {item.description && <span class="desc">{item.description}</span>}
    <span class="more">{more}</span>
  </span>
</a>

<style>
  .case { position: relative; display: block; aspect-ratio: 312 / 450; border-top-left-radius: 39px; overflow: hidden; background: var(--vt-navy); color: var(--vt-white); }
  .case:hover { text-decoration: none; }
  .front, .back { position: absolute; inset: 0; }
  .front img, .back img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* overlays do original: frente rgba(16,24,32,.63), verso .92 */
  .front::after, .back::before { content: ""; position: absolute; inset: 0; background: rgb(16 24 32 / .63); }
  .back::before { z-index: 1; background: rgb(16 24 32 / .92); }
  .title { position: absolute; left: 32px; right: 32px; bottom: 32px; z-index: 1; text-align: center; font-size: 22px; font-weight: 500; line-height: 1.4; }
  .back {
    z-index: 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24px;
    padding: 32px; text-align: center;
    transform: translateY(-100%); transition: transform .6s ease-in-out;
  }
  .back > span { position: relative; z-index: 2; }
  .case:hover .back, .case:focus-visible .back { transform: none; }
  .desc { font-size: 16px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 9; -webkit-box-orient: vertical; overflow: hidden; }
  .more { background: var(--vt-white); color: #030303; border-radius: 8px; padding: 10px 20px; font-size: 15px; font-weight: 500; line-height: 1; }
  @media (max-width: 767px) { .title { font-size: 18px; } }
  @media (prefers-reduced-motion: reduce) { .back { transition: none; } }
</style>
