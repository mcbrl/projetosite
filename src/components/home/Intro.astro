---
import { homeOf } from "../../lib/home";
import { langOf } from "../../lib/i18n";
const lang = langOf(Astro.url);
const home = homeOf(lang);
const { intro, stats } = home;
---
<section class="intro">
  <div class="container grid">
    <h2 class="headline" data-anim="fadeInRight" data-delay="350">{intro.headline.map((w) => <span>{w}</span>)}</h2>
    <div class="text" set:html={intro.html} />
  </div>
</section>
<section class="stats" aria-label={lang === "en" ? "Vertigo in numbers" : "Números da Vertigo"}>
  <div class="container row">
    {stats.map((s) => {
      // "25+" -> contador 0→25 com sufixo "+" (widget Counter do Elementor)
      const [, num, suffix] = s.value.match(/^(\d+)(.*)$/) ?? [, s.value, ""];
      return <div class="stat"><strong><span data-count-to={num}>{num}</span>{suffix}</strong><span class="label">{s.label}</span></div>;
    })}
  </div>
</section>
<style>
  .intro { padding: 112px 0; }
  .grid { display: grid; grid-template-columns: 576fr 608fr; gap: 96px; align-items: center; }
  .headline { display: flex; flex-direction: column; align-items: flex-end; color: var(--vt-blue); font-size: 54px; font-weight: 600; line-height: 1.2; letter-spacing: -1px; margin: 0; }
  .text { font-size: 19px; line-height: 24px; }
  .text :global(p) { margin: 0 0 14.4px; }
  .text :global(b) { font-weight: 700; }
  .stats { background: var(--vt-blue); color: var(--vt-white); padding: 32px 0; }
  .row { display: grid; grid-template-columns: repeat(4, 1fr); }
  .stat { display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 0 16px; text-align: center; }
  .stat + .stat { border-left: 1px dashed var(--vt-white-60); }
  strong { font-size: 48px; font-weight: 600; line-height: 1.1; letter-spacing: -1px; }
  .label { font-size: var(--fs-chip); font-weight: 500; line-height: 1.5; text-transform: uppercase; }
  @media (max-width: 900px) {
    .intro { padding: 48px 0; }
    .grid { grid-template-columns: 1fr; gap: 40px; }
    .headline { align-items: flex-start; font-size: 32px; }
    .text { line-height: 1.1; }
    .stats { padding: 0; }
    .row { grid-template-columns: 1fr 1fr; padding: 0; }
    .stat { padding: 24px 8px; }
    .stat + .stat { border-left: 0; }
    .stat:nth-child(even) { border-left: 1px dashed var(--vt-white-60); }
    .stat:nth-child(n+3) { border-top: 1px dashed var(--vt-white-60); }
    strong { font-size: 32px; }
  }
</style>
