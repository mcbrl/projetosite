---
import { homeOf } from "../../lib/home";
import { langOf } from "../../lib/i18n";
const home = homeOf(langOf(Astro.url));
const v = home.veecode;
---
<section class="vee">
  <div class="container grid">
    {v.image && <img src={v.image} alt="VeeCode Platform" loading="lazy" width="607" height="434" />}
    <div>
      <span class="chip chip-blue" data-anim="fadeInUp" data-delay="200">{v.eyebrow}</span>
      <h2 class="t-h2">{v.title}</h2>
      <p data-anim="fadeInUp" data-delay="350">{v.text}</p>
    </div>
  </div>
  <p class="cta"><a class="btn btn-primary" href={v.href} target="_blank" rel="noopener">{v.cta}</a></p>
</section>
<style>
  .vee { padding: 110px 0 100px; }
  .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 110px; align-items: center; padding: 0 12px; }
  h2 { margin: 24px 0 16px; }
  p { font-size: var(--fs-large); line-height: 1.4; }
  .cta { text-align: center; margin: 100px 0 0; }
  @media (max-width: 900px) { .vee { padding: 64px 0; } .grid { grid-template-columns: 1fr; gap: 32px; } .cta { margin-top: 32px; } }
</style>
