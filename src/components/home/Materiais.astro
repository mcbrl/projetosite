---
import Carousel from "../Carousel.astro";
import CaseCard from "../CaseCard.astro";
import { materiais } from "../../lib/materiais";
import { site } from "../../data/site";
import { href, langOf, ui } from "../../lib/i18n";
const lang = langOf(Astro.url);
const items = await materiais(lang);
---
<section class="mat">
  <div class="container">
    <p class="eyebrow"><span class="chip chip-blue" data-anim="fadeInUp" data-delay="200">{ui(lang).materials}</span></p>
    <h2 class="t-h2">{lang === "en" ? "Practical applications and real-world results" : "Aplicações práticas e resultados reais"}</h2>
    <Carousel label={ui(lang).materials} tone="light" perView={3} perViewTablet={2} perViewMobile={1} gap={2}>
      {items.map((item) => <CaseCard item={item} />)}
    </Carousel>
    <p class="cta"><a class="btn btn-primary" href={href(lang, site.cta.href)}>{ui(lang).cta}</a></p>
  </div>
</section>
<style>
  .mat { background: var(--vt-line); padding: 100px 0 60px; text-align: center; }
  .eyebrow { margin: 0 0 20px; }
  h2 { color: var(--vt-blue); margin-bottom: 32px; }
  .mat :global(.carousel) { padding: 0; }
  .mat :global(.carousel .nav) { margin: 0 -40px; }
  .cta { margin: 48px 0 0; }
  @media (max-width: 767px) { .mat :global(.carousel .nav) { margin: 0; } }
</style>
