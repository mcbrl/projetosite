---
import home from "../../data/home.json";
---
<section class="section section-gray">
  <div class="container">
    <h2 class="t-h2 title">Somos especialistas em</h2>
    <ul class="grid">
      {home.especialistas.map((e) => (
        <li>
          <img src={e.icon} alt="" width="80" height="80" loading="lazy" />
          <h3>{e.title}</h3>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .section { padding: 112px 0 120px; }
  .title { color: var(--vt-navy); font-weight: 500; margin-bottom: 40px; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 24px; text-align: center; }
  img { width: 80px; height: 80px; margin: 0 auto 16px; }
  h3 { color: var(--vt-navy); font-size: 20px; font-weight: 500; line-height: 1.3; letter-spacing: 0; margin: 0; }
  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(3, 1fr); row-gap: 40px; } }
  @media (max-width: 600px) { .title { text-align: center; } .grid { grid-template-columns: 1fr; } }
</style>
