---
import Icon from "./Icon.astro";
import { categoryNames, entryLang, pathOf, type PostEntry } from "../lib/routes";
import { ui } from "../lib/i18n";
interface Props { post: PostEntry }
const { post } = Astro.props;
const href = pathOf(post);
const lang = entryLang(post);
const t = ui(lang);
const cats = categoryNames(post.data.categories, { lang }).join(", ");
const excerpt = (post.data.excerpt ?? "").replace(/\s*\[…\]$/, "…");
---
<article class="card">
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {post.data.featuredImage
      ? <img src={post.data.featuredImage} alt={post.data.featuredImageAlt ?? ""} loading="lazy" width="400" height="245" />
      : <span class="ph" />}
  </a>
  <div class="body">
    {cats && <p class="cats">{cats}</p>}
    <h2 class="title"><a href={href}>{post.data.title}</a></h2>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <a class="more" href={href} aria-label={`${t.learnMore}: ${post.data.title}`}>{t.learnMore} <Icon name="arrow-right" size={18} /></a>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; background: #f5f5f5; height: 100%; }
  .thumb { display: block; aspect-ratio: 400 / 245; overflow: hidden; background: var(--vt-ink); border-top-left-radius: 30px; }
  .thumb img, .ph { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card:hover .thumb img { transform: scale(1.04); }
  .body { display: flex; flex-direction: column; flex: 1; padding: 40px 30px 44px; }
  .cats { font-size: 15px; font-weight: 500; color: var(--vt-text); margin: 0 0 12px; }
  .title { font-size: 26px; font-weight: 400; line-height: 1.1; letter-spacing: -0.5px; margin: 0 0 24px; }
  .title a { color: var(--vt-black); }
  .excerpt { color: #5f6368; font-size: var(--fs-text); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; margin: 0 0 32px; }
  .more { margin-top: auto; display: inline-flex; align-items: center; gap: 24px; text-transform: uppercase; color: var(--vt-black); font-size: 18px; line-height: 1; }
  .more:hover { color: var(--vt-blue); text-decoration: none; }
  .cats { line-height: 1.2; }
  @media (max-width: 767px) { .title { font-size: 20px; } .more { font-size: 13px; } .cats { font-size: 14px; } }
</style>
