---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { categoryNames, pathOf } from "../lib/routes";
interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const href = pathOf(post);
const cats = categoryNames(post.data.categories).join(", ");
const excerpt = (post.data.excerpt ?? "").replace(/\s*\[…\]$/, "…");
---
<article class="card">
  <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
    {post.data.featuredImage
      ? <img src={post.data.featuredImage} alt={post.data.featuredImageAlt ?? ""} loading="lazy" width="400" height="245" />
      : <span class="ph" />}
  </a>
  <div class="body">
    {cats && <p class="cats">{cats}</p>}
    <h2 class="title"><a href={href}>{post.data.title}</a></h2>
    {excerpt && <p class="excerpt">{excerpt}</p>}
    <a class="more" href={href} aria-label={`Saiba mais: ${post.data.title}`}>Saiba mais <Icon name="arrow-right" size={18} /></a>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; background: var(--vt-surface); height: 100%; }
  .thumb { display: block; aspect-ratio: 400 / 245; overflow: hidden; background: var(--vt-ink); }
  .thumb img, .ph { width: 100%; height: 100%; object-fit: cover; transition: transform .4s ease; }
  .card:hover .thumb img { transform: scale(1.04); }
  .body { display: flex; flex-direction: column; flex: 1; padding: 40px 30px 44px; }
  .cats { font-size: 15px; font-weight: 500; color: var(--vt-text); margin: 0 0 12px; }
  .title { font-size: 24px; font-weight: 400; line-height: 1.2; letter-spacing: -0.5px; margin: 0 0 24px; }
  .title a { color: var(--vt-black); }
  .excerpt { color: #5f6368; font-size: 16px; display: -webkit-box; -webkit-line-clamp: 5; -webkit-box-orient: vertical; overflow: hidden; margin: 0 0 32px; }
  .more { margin-top: auto; display: inline-flex; align-items: center; gap: 24px; text-transform: uppercase; color: var(--vt-black); font-size: 17px; }
  .more:hover { color: var(--vt-blue); text-decoration: none; }
</style>
