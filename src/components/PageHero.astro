---
// Hero padrão das páginas internas: imagem de fundo + overlay, chip e título.
interface Props { title: string; eyebrow?: string; image?: string; meta?: string; align?: "left" | "center"; animate?: boolean; size?: "h1" | "display" }
const { title, eyebrow, image, meta, align = "left", animate = false, size = "h1" } = Astro.props;
const anim = animate ? { "data-anim": "fadeInUp", "data-delay": "300" } : {};
---
<section class:list={["hero", `hero-${align}`]} style={image ? `--hero-img: url('${encodeURI(image)}')` : undefined}>
  <div class="container inner">
    {eyebrow && <span class="chip">{eyebrow}</span>}
    <h1 class={size === "display" ? "t-display" : "t-h1"} {...anim}>{title}</h1>
    {meta && <p class="meta"><slot name="meta-icon" />{meta}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative; display: flex; align-items: center; min-height: 520px; padding: 80px 0;
    background: var(--vt-ink) var(--hero-img, none) center / cover no-repeat; color: var(--vt-white);
    isolation: isolate;
  }
  .hero::before { content: ""; position: absolute; inset: 0; z-index: -1; background: rgb(16 24 32 / .5); }
  .inner { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .hero-center .inner { align-items: center; text-align: center; }
  h1 { margin: 0; max-width: 820px; text-shadow: 0 2px 12px rgb(0 0 0 / .25); }
  .chip { color: var(--vt-white); }
  .meta { display: flex; align-items: center; gap: 6px; margin: 0; font-size: 14px; line-height: 1.5; }
  @media (max-width: 767px) { .meta { font-size: 12px; } }
  @media (max-width: 767px) { .hero { min-height: 380px; padding: 64px 0; } }
</style>
