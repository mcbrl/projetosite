---
// Arquivo de categoria/tag do blog: hero com o termo, grade de posts e paginação.
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "./PageHero.astro";
import PostCard from "./PostCard.astro";
import Pagination from "./Pagination.astro";
import { metaOf, type PostEntry } from "../lib/routes";
import { href, langOf } from "../lib/i18n";
import { taxLabel, termPath, type TaxKind } from "../lib/taxonomy";

interface Props { kind: TaxKind; slug: string; name: string; posts: PostEntry[]; current: number; last: number; total: number }
const { kind, slug, name, posts, current, last, total } = Astro.props;
const lang = langOf(Astro.url);
const en = lang === "en";
const base = termPath(kind, slug, lang);
const title = `${name}${current > 1 ? ` - ${en ? "Page" : "Página"} ${current}` : ""} - Vertigo`;
const seo = {
  title,
  description: en ? `Vertigo articles about ${name}.` : `Artigos da Vertigo sobre ${name}.`,
  canonical: current > 1 ? undefined : `https://vertigo.com.br${base}`,
  robots: "index, follow",
};
---
<BaseLayout title={name} seo={seo}>
  <PageHero eyebrow={taxLabel(kind, lang)} title={name} image={metaOf("/blog/").heroImage} />
  <section class="section">
    <div class="container">
      <p class="count">{total} {en ? (total === 1 ? "article" : "articles") : (total === 1 ? "artigo" : "artigos")} · <a href={href(lang, "/blog/")}>{en ? "See all articles" : "Ver todos os artigos"}</a></p>
      <div class="grid">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination current={current} last={last} base={base} />
    </div>
  </section>
</BaseLayout>

<style>
  .count { color: #5f6368; margin: 0 0 40px; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  @media (max-width: 1024px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 24px; } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
