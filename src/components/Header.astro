---
import Icon from "./Icon.astro";
import { mainNav, site } from "../data/site";
import { href, langOf, pathIn, ui } from "../lib/i18n";

const current = Astro.url.pathname;
const lang = langOf(Astro.url);
const t = ui(lang);
const nav = mainNav(lang);
const home = href(lang, "/");
const cta = href(lang, site.cta.href);
const isActive = (href: string, children?: unknown[]) =>
  href === home ? current === home : current.startsWith(href) || (!!children && /-tier-/.test(current));
const flags = [
  { lang: "en", label: t.langEn, src: "/theme/flags/en-us.svg", href: pathIn("en", current) },
  { lang: "pt", label: t.langPt, src: "/theme/flags/pt-br.svg", href: pathIn("pt", current) },
] as const;
---
<header class="site-header" data-header>
  <div class="container bar">
    <a class="logo" href={home} aria-label={`${site.name} — ${t.home}`}>
      <img src={site.logo.light} alt={`${site.name} — ${site.tagline}`} width="258" height="56" />
    </a>

    <nav class="nav" aria-label={t.mainMenu} id="main-nav">
      <ul>
        {nav.map((item) => (
          <li class:list={{ "has-sub": !!item.children }}>
            <a href={item.href} class:list={{ active: isActive(item.href, item.children) }} aria-current={isActive(item.href, item.children) ? "page" : undefined}>
              {item.label}
              {item.children && <Icon name="chevron-down" size={14} />}
            </a>
            {item.children && (
              <div class="mega">
                {item.children.map((group) => (
                  <div class="mega-col">
                    <span class="mega-title">{group.label}</span>
                    <ul>
                      {group.items.map((l) => (
                        <li><a href={l.href} class:list={{ active: current === l.href }}>{l.label}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            )}
          </li>
        ))}
        <li class="langs">
          {flags.map((f) => (
            <a class:list={["flag", { current: f.lang === lang }]} href={f.href} hreflang={f.lang === "en" ? "en-US" : "pt-BR"} lang={f.lang === "en" ? "en" : "pt-BR"} title={f.label} aria-label={f.label} aria-current={f.lang === lang ? "true" : undefined}>
              <img src={f.src} alt="" width="24" height="16" />
            </a>
          ))}
        </li>
      </ul>
      <a class="btn btn-primary btn-sm cta cta-mobile" href={cta}>{t.cta}</a>
    </nav>

    <a class="btn btn-primary btn-sm cta" href={cta}>{t.cta}</a>

    <button class="burger" type="button" aria-controls="main-nav" aria-expanded="false" aria-label={t.menuOpen} data-burger data-open={t.menuOpen} data-close={t.menuClose}>
      <Icon name="menu" size={22} class="i-open" />
      <Icon name="close" size={22} class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]")!;
  const burger = header.querySelector<HTMLButtonElement>("[data-burger]")!;
  burger.addEventListener("click", () => {
    const open = header.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", (open ? burger.dataset.close : burger.dataset.open) ?? "");
    document.body.style.overflow = open ? "hidden" : "";
  });
  // No mobile, o item com submenu abre/fecha em vez de navegar
  header.querySelectorAll<HTMLAnchorElement>(".has-sub > a").forEach((a) =>
    a.addEventListener("click", (e) => {
      if (window.matchMedia("(max-width: 1024px)").matches) {
        e.preventDefault();
        a.parentElement!.classList.toggle("sub-open");
      }
    }),
  );
  // Sombra quando rola (sticky-header-effects)
  const onScroll = () => header.classList.toggle("scrolled", window.scrollY > 10);
  addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; background: var(--vt-white);
    border-bottom: 1px solid #d9d9d9; transition: box-shadow .2s ease;
  }
  .site-header.scrolled { box-shadow: 0 4px 18px rgb(0 0 0 / .08); }
  .bar { display: flex; align-items: center; gap: 24px; height: var(--vt-header-h); }
  .logo img { width: 258px; height: auto; }
  .nav { margin-left: auto; }
  .nav > ul { display: flex; align-items: center; gap: 20px; list-style: none; margin: 0; padding: 0; }
  .nav a { color: var(--vt-black); font-weight: 600; font-size: 16px; line-height: 1.5; display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .nav a:hover, .nav a.active { color: var(--vt-blue); }
  .nav > ul > li { position: relative; padding: 32px 0; }
  .cta { margin-left: 28px; white-space: nowrap; font-size: 13px; font-weight: 500; line-height: 1; padding: 12px 24px; }
  .nav .cta-mobile { display: none; }
  /* bandeiras do GTranslate (24x16, lado a lado depois do Blog) */
  .nav > ul > li.langs { display: flex; gap: 12px; padding: 0; }
  .flag { display: block; line-height: 0; opacity: .85; transition: opacity .2s; }
  .flag:hover, .flag.current { opacity: 1; }
  .flag img { width: 24px; height: 16px; box-shadow: 0 0 0 1px rgb(0 0 0 / .08); }

  /* mega menu de soluções */
  .mega {
    position: absolute; top: 100%; left: 50%; transform: translate(-50%, 8px);
    display: grid; grid-template-columns: repeat(3, minmax(220px, 1fr)); gap: 32px;
    padding: 28px 32px; background: var(--vt-white); border-radius: 12px;
    box-shadow: 0 18px 40px rgb(16 24 32 / .16); opacity: 0; visibility: hidden;
    transition: opacity .18s ease, transform .18s ease; width: max-content;
  }
  .has-sub:hover .mega, .has-sub:focus-within .mega { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  /* hierarquia: tier = rótulo pequeno em caixa alta; soluções = links de leitura */
  .mega-title {
    display: block; font-size: 12px; line-height: 16px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
    color: var(--vt-blue); padding-bottom: 12px; margin-bottom: 16px; border-bottom: 1px solid var(--vt-line);
  }
  .mega ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .mega a { font-weight: 400; font-size: 15px; line-height: 20px; color: var(--vt-text, #333); }
  .mega a:hover, .mega a.active { color: var(--vt-blue); }

  .burger { display: none; margin-left: auto; width: 38px; height: 38px; border: 0; border-radius: 6px; background: var(--vt-black); color: var(--vt-white); cursor: pointer; align-items: center; justify-content: center; }
  .burger :global(.i-close) { display: none; }

  @media (max-width: 1240px) { .nav > ul { gap: 14px; } .nav a { font-size: 15px; } .cta { margin-left: 8px; } }

  @media (max-width: 1024px) {
    .logo img { width: 230px; }
    .burger { display: inline-flex; }
    .cta:not(.cta-mobile) { display: none; }
    .nav {
      position: fixed; inset: var(--vt-header-h) 0 0 0; background: var(--vt-white); overflow-y: auto;
      padding: 16px var(--vt-gutter) 32px; display: none;
    }
    .site-header.open .nav { display: block; }
    .site-header.open .burger :global(.i-open) { display: none; }
    .site-header.open .burger :global(.i-close) { display: block; }
    .nav > ul { flex-direction: column; align-items: stretch; gap: 0; }
    .nav > ul > li { padding: 0; border-bottom: 1px solid var(--vt-line); }
    .nav > ul > li > a { padding: 16px 0; width: 100%; justify-content: space-between; }
    .nav > ul > li.langs { padding: 16px 0; gap: 16px; }
    .nav > ul > li.langs > a { width: auto; padding: 0; }
    .mega { position: static; transform: none; opacity: 1; visibility: visible; display: none; box-shadow: none; padding: 0 0 16px 12px; grid-template-columns: 1fr; gap: 16px; width: auto; }
    .has-sub.sub-open .mega { display: grid; }
    .has-sub:hover .mega { transform: none; }
    .nav .cta-mobile { display: inline-flex; margin: 24px 0 0; color: var(--vt-white); }
  }
  @media (max-width: 767px) { .logo img { width: 228px; } .nav a, .mega a { font-size: 14px; } .mega-title { font-size: 11px; } }
</style>
