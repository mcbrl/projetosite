---
import HubSpotForm from "./HubSpotForm.astro";
import { hubspot } from "../data/site";
---
<section class="wa" aria-label="WhatsApp" data-wa>
  <button class="wa-btn" type="button" aria-label="Abrir formulário WhatsApp" aria-controls="wa-panel" aria-expanded="false" data-wa-open>
    <img src="/theme/img/whatsapp.svg" alt="" width="64" height="64" />
  </button>
  <div class="wa-overlay" data-wa-close></div>
  <div class="wa-panel" id="wa-panel" role="dialog" aria-modal="true" aria-labelledby="wa-title" hidden>
    <button class="wa-close" type="button" aria-label="Fechar" data-wa-close>×</button>
    <p class="wa-copy" id="wa-title">Olá! Preencha os campos abaixo para iniciar a conversa no WhatsApp.</p>
    <div class="wa-form"><HubSpotForm formId={hubspot.forms.whatsapp} load="manual" /></div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-wa]")!;
  const panel = root.querySelector<HTMLElement>(".wa-panel")!;
  const btn = root.querySelector<HTMLButtonElement>("[data-wa-open]")!;
  const toggle = (open: boolean) => {
    root.classList.toggle("open", open);
    panel.hidden = !open;
    btn.setAttribute("aria-expanded", String(open));
    // como no original, o formulário só é carregado quando o painel abre
    if (open) (window as any).vtRenderHsForm?.(panel.querySelector("[data-hs-form]"));
  };
  btn.addEventListener("click", () => toggle(true));
  root.querySelectorAll("[data-wa-close]").forEach((el) => el.addEventListener("click", () => toggle(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && toggle(false));
</script>

<style>
  .wa-btn { position: fixed; right: 24px; bottom: 24px; z-index: 60; width: 64px; height: 64px; border: 0; padding: 0; background: none; cursor: pointer; border-radius: 50%; box-shadow: 0 6px 20px rgb(0 0 0 / .25); animation: vt-shake 6s infinite; }
  .wa-overlay { position: fixed; inset: 0; background: rgb(0 0 0 / .45); z-index: 70; display: none; }
  .wa.open .wa-overlay { display: block; }
  .wa-panel { position: fixed; right: 24px; bottom: 100px; z-index: 71; width: min(380px, calc(100vw - 32px)); max-height: calc(100vh - 140px); overflow-y: auto; background: var(--vt-white); border-radius: 12px; box-shadow: 0 20px 50px rgb(0 0 0 / .3); }
  .wa-copy { margin: 0; padding: 20px 44px 20px 20px; background: var(--vt-blue-soft); color: var(--vt-white); font-weight: 600; text-align: center; }
  .wa-close { position: absolute; top: 8px; right: 10px; background: none; border: 0; color: var(--vt-white); font-size: 26px; cursor: pointer; line-height: 1; }
  .wa-form { padding: 20px; }
  @keyframes vt-shake {
    0%, 4%, 11%, 100% { transform: none; }
    5% { transform: translate(1px, 1px) rotate(0); } 6% { transform: translate(-3px, 0) rotate(1deg); }
    7% { transform: translate(1px, -1px) rotate(1deg); } 8% { transform: translate(-3px, 1px) rotate(0); }
    9% { transform: translate(-1px, -1px) rotate(1deg); } 10% { transform: translate(1px, -2px) rotate(-1deg); }
  }
  @media (prefers-reduced-motion: reduce) { .wa-btn { animation: none; } }
</style>
