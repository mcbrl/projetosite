---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import PostSidebar from "../components/PostSidebar.astro";
import Icon from "../components/Icon.astro";
import { categoryNames, formatDate } from "../lib/routes";

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { title, date, modified, featuredImage, seo } = post.data;
// O hero mostra todas as categorias, como o original ("A VERTIGO, BLOG")
const url = new URL(Astro.url.pathname, Astro.site).href;
const eyebrow = categoryNames(post.data.categories, { keepBlog: true }).join(", ");
---
<BaseLayout title={title} seo={seo} type="article" publishedTime={date} modifiedTime={modified}>
  <PageHero title={title} eyebrow={eyebrow || "Blog"} image={featuredImage} meta={formatDate(date)}>
    <Icon slot="meta-icon" name="calendar" size={14} />
  </PageHero>
  <section class="section">
    <div class="container layout">
      <article class="prose">
        <h1>{title}</h1>
        <slot />
        <div class="share">
          <span>Compartilhe:</span>
          <a class="fb" href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Compartilhar no Facebook"><Icon name="facebook" size={16} /></a>
          <a class="tw" href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`} target="_blank" rel="noopener" aria-label="Compartilhar no X/Twitter"><Icon name="twitter" size={16} /></a>
          <a class="li" href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Compartilhar no LinkedIn"><Icon name="linkedin" size={16} /></a>
        </div>
      </article>
      <PostSidebar exclude={post.id} />
    </div>
  </section>
</BaseLayout>

<style>
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 368px; gap: 48px; align-items: start; }
  .prose :global(h1) { font-size: var(--fs-h1); }
  .share { display: flex; align-items: center; gap: 6px; margin-top: 48px; padding: 20px 0; border-top: 1px solid #90a4ae; border-bottom: 1px solid #90a4ae; }
  .share span { font-weight: 600; margin-right: 14px; }
  .share a { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; color: var(--vt-white); text-decoration: none; }
  .share .fb { background: #3b5998; } .share .tw { background: #1da1f2; } .share .li { background: #0077b5; }
  @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; } }
</style>
