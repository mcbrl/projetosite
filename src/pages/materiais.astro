---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import CaseCard from "../components/CaseCard.astro";
import categorias from "../../data/case-categorias.json";
import { isPublished, metaOf, pageAt } from "../lib/routes";

const page = await pageAt("/materiais/");
const items = (await getCollection("cases")).filter(isPublished).sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
---
<BaseLayout title="Materiais" seo={page?.data.seo}>
  <PageHero eyebrow="Materiais" title="Nossos Cases e Ebooks" image={metaOf("/materiais/").heroImage} />
  <section class="section">
    <div class="container layout">
      <form class="filters" data-filters>
        <p>Filtre abaixo as opções.</p>
        <label class="sr-only" for="mq">Buscar</label>
        <input id="mq" type="search" name="q" placeholder="Buscar" />
        <fieldset>
          <legend>Categoria</legend>
          {categorias.map((c) => (
            <label><input type="radio" name="cat" value={c.slug} /> {c.name}</label>
          ))}
        </fieldset>
      </form>
      <div class="grid" data-cases>
        {items.map((item) => <CaseCard item={item} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-filters]")!;
  const cards = [...document.querySelectorAll<HTMLElement>("[data-cases] > a")];
  const norm = (s: string) => s.normalize("NFD").replace(/\p{Diacritic}/gu, "").toLowerCase();
  const apply = () => {
    const data = new FormData(form);
    const q = norm(String(data.get("q") ?? ""));
    const cat = String(data.get("cat") ?? "");
    cards.forEach((c) => { c.hidden = !((!cat || c.dataset.cats!.split(" ").includes(cat)) && norm(c.textContent ?? "").includes(q)); });
  };
  form.addEventListener("input", apply);
  form.addEventListener("submit", (e) => e.preventDefault());
  // clicar de novo no rádio selecionado limpa o filtro
  form.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((r) =>
    r.addEventListener("click", () => { if (r.dataset.was === "1") { r.checked = false; apply(); } form.querySelectorAll<HTMLInputElement>("input[type=radio]").forEach((x) => (x.dataset.was = x.checked ? "1" : "")); }),
  );
</script>

<style>
  .layout { display: grid; grid-template-columns: 255px 1fr; gap: 20px; align-items: start; }
  .filters { background: var(--vt-ink); color: var(--vt-white); padding: 32px 20px; border-radius: 2px; font-size: 16px; }
  .filters p { margin: 0 0 24px; }
  .filters input[type=search] { width: 100%; padding: 10px; border: 0; border-radius: 2px; font: 13px var(--vt-font); margin-bottom: 24px; }
  fieldset { border: 0; padding: 0; margin: 0; display: grid; gap: 10px; font-size: 14px; }
  legend { font-size: 18px; line-height: 1.5; margin-bottom: 12px; padding: 0; }
  @media (max-width: 767px) { legend { font-size: 14px; } .filters p { font-size: 15px; } }
  fieldset label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid :global([hidden]) { display: none; }
  @media (max-width: 1024px) { .layout { grid-template-columns: 1fr; } .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }
</style>
