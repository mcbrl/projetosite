---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import HubSpotForm from "../components/HubSpotForm.astro";
import Icon from "../components/Icon.astro";
import { hubspot, site } from "../data/site";
import { metaOf, pageAt } from "../lib/routes";
import { langOf } from "../lib/i18n";

const lang = langOf(Astro.url);
const en = lang === "en";
const page = await pageAt("/contato/", lang);
---
<BaseLayout title={en ? "Contact" : "Contato"} seo={page?.data.seo}>
  <PageHero eyebrow={en ? "Contact Us" : "Fale Conosco"} title={en ? "Ready to fly your business with Vertigo?" : "Pronto para acelerar com a Vertigo?"} image={metaOf("/contato/").heroImage} />
  <section class="section">
    <div class="container split">
      <div data-anim="fadeInLeft" data-delay="200">
        <h2 class="lead">{en ? "Fill out the form to receive contact from one of our specialists." : "Preencha o formulário para receber o contato de um de nossos especialistas."}</h2>
        <div class="social">
          <span>{en ? "Follow on social media:" : "Siga nas redes sociais:"}</span>
          <ul>
            {site.social.map((s) => <li><a href={s.href} target="_blank" rel="noopener" aria-label={s.name}><Icon name={s.icon} size={20} /></a></li>)}
          </ul>
        </div>
      </div>
      <div class="form-panel" data-anim="fadeInUp" data-delay="200"><HubSpotForm formId={hubspot.forms.contato} dark load="eager" /></div>
    </div>
  </section>
</BaseLayout>

<style>
  .split { display: grid; grid-template-columns: 560px 1fr; gap: 80px; align-items: start; }
  .lead { color: var(--vt-blue); font-size: 27px; font-weight: 700; line-height: 1.5; letter-spacing: 0; padding-bottom: 20px; border-bottom: 1px solid #999; margin-bottom: 20px; }
  .social { display: flex; align-items: center; gap: 20px; font-size: var(--fs-h4); font-weight: 500; line-height: 1.4; flex-wrap: wrap; }
  @media (max-width: 767px) { .lead { font-size: 14px; } }
  .social ul { display: flex; gap: 5px; list-style: none; margin: 0; padding: 0; }
  .social a { width: 44px; height: 44px; border-radius: 50%; background: var(--vt-blue); color: var(--vt-white); display: grid; place-items: center; transition: transform .3s; }
  .social a:hover { transform: translateY(-8px); } /* elementor-animation-float */
  .form-panel { background: var(--vt-ink); padding: 48px; border-radius: 4px; box-shadow: 0 10px 40px rgb(0 0 0 / .12); }
  @media (max-width: 1024px) { .split { grid-template-columns: 1fr; gap: 40px; } .form-panel { padding: 32px 24px; } }
</style>
