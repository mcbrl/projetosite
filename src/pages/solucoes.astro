---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import TierColumns from "../components/TierColumns.astro";
import { homeOf } from "../lib/home";
import { metaOf, pageAt } from "../lib/routes";
import { langOf } from "../lib/i18n";

const lang = langOf(Astro.url);
const en = lang === "en";
const home = homeOf(lang);
const page = await pageAt("/solucoes/", lang);
---
<BaseLayout title={en ? "Our Solutions" : "Nossas Soluções"} seo={page?.data.seo}>
  <PageHero eyebrow={en ? "Our Solutions" : "Nossas Soluções"} title={en ? "Accelerate your business." : "Acelere o seu negócio"} image={metaOf("/solucoes/").heroImage} />
  {home.tiers.map((tier, i) => (
    <section class:list={["section", { "section-dark": i % 2 === 1 }]}>
      <div class="container">
        <h2 class="tier-title">{tier.title}</h2>
        <p class="tier-desc">{tier.description}</p>
        <TierColumns columns={tier.columns} tone={i % 2 === 1 ? "dark" : "light"} />
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .tier-title { color: var(--vt-blue); font-size: var(--fs-h2); line-height: 1.2; margin-bottom: 24px; }
  .tier-desc { font-size: var(--fs-lead); margin-bottom: 24px; }
</style>
