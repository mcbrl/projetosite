---
import BlogIndex from "../../components/BlogIndex.astro";
import { PER_PAGE, postsOf, sortPosts } from "../../lib/routes";
import { langOf } from "../../lib/i18n";

const posts = sortPosts(await postsOf(langOf(Astro.url)));
---
<BlogIndex posts={posts.slice(0, PER_PAGE)} current={1} last={Math.ceil(posts.length / PER_PAGE)} />