---
import { getCollection } from "astro:content";
import BlogIndex from "../../../components/BlogIndex.astro";
import { PER_PAGE, sortPosts } from "../../../lib/routes";

// /blog/page/2/ em diante (a página 1 é /blog/)
export async function getStaticPaths() {
  const posts = sortPosts(await getCollection("blog"));
  const last = Math.ceil(posts.length / PER_PAGE);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => {
    const n = i + 2;
    return { params: { page: String(n) }, props: { posts: posts.slice((n - 1) * PER_PAGE, n * PER_PAGE), current: n, last } };
  });
}

const { posts, current, last } = Astro.props;
---
<BlogIndex posts={posts} current={current} last={last} />
