---
// Catch-all: páginas do WordPress e posts do blog vivem na raiz (/slug/).
import { getCollection, render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PostLayout from "../layouts/PostLayout.astro";
import { CUSTOM_ROUTES, isPublished, metaOf, pathOf, toParam } from "../lib/routes";

export async function getStaticPaths() {
  const pages = (await getCollection("pages")).filter(isPublished);
  const posts = (await getCollection("blog")).filter(isPublished);
  const seen = new Map<string, string>();
  const routes = [];
  for (const entry of [...pages, ...posts]) {
    const path = pathOf(entry);
    if (CUSTOM_ROUTES.has(path)) continue;
    const key = `${entry.collection}/${entry.id}`;
    if (seen.has(path)) throw new Error(`Caminho duplicado ${path}: ${seen.get(path)} e ${key}`);
    seen.set(path, key);
    routes.push({ params: { slug: toParam(path) }, props: { entry } });
  }
  return routes;
}

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const meta = metaOf(pathOf(entry));
---
{entry.collection === "blog" ? (
  <PostLayout post={entry}><Content /></PostLayout>
) : (
  <PageLayout
    title={fm.heroTitle ?? entry.data.title}
    eyebrow={fm.heroEyebrow}
    heroImage={meta.heroImage ?? entry.data.featuredImage}
    seo={entry.data.seo}
    formId={meta.hubspotForm}
    formTitle={fm.formTitle}
  >
    <Content />
  </PageLayout>
)}
