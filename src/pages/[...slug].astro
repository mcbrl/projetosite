---
// Catch-all: páginas do WordPress e posts do blog vivem na raiz (/slug/).
import { render } from "astro:content";
import PageLayout from "../layouts/PageLayout.astro";
import PostLayout from "../layouts/PostLayout.astro";
import { metaOf, pathOf } from "../lib/routes";
import { contentPaths } from "../lib/paths";
import { stripLang } from "../lib/i18n";

export const getStaticPaths = () => contentPaths("pt");

const { entry } = Astro.props;
const { Content, remarkPluginFrontmatter: fm } = await render(entry);
const path = stripLang(pathOf(entry));
const meta = metaOf(path);
const motion = /^\/(strategy|business|tech)-tier-/.test(path) ? "tier"
  : ["/canal-de-denuncias/", "/ouvidoria/"].includes(path) ? "left"
  : undefined;
---
{entry.collection.startsWith("blog") ? (
  <PostLayout post={entry}><Content /></PostLayout>
) : (
  <PageLayout
    title={fm.heroTitle ?? entry.data.title}
    eyebrow={fm.heroEyebrow}
    heroImage={meta.heroImage ?? entry.data.featuredImage}
    seo={entry.data.seo}
    formId={meta.hubspotForm}
    formTitle={fm.formTitle}
    motion={motion}
  >
    <Content />
  </PageLayout>
)}
