---
// /carreiras/ — template próprio (o Markdown do Elementor perde os cards e as colunas).
// Textos de src/content/pages/carreiras.md (snapshot do WordPress).
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import ImageCta from "../components/ImageCta.astro";
import Icon from "../components/Icon.astro";
import { metaOf, pageAt } from "../lib/routes";
import { langOf } from "../lib/i18n";

const lang = langOf(Astro.url);
const en = lang === "en";
const page = await pageAt("/carreiras/", lang);
const T = <A,>(pt: A, e: A) => (en ? e : pt);
const up = "/wp-content/uploads/2026/02";

const motivos = [
  { icon: `${up}/www.flaticon.com-11.svg`, title: T("Cultura que cuida e desafia", "A culture that cares and challenges."), text: T("Você é apoiado como pessoa e provocado como profissional.", "You are supported as a person and challenged as a professional.") },
  { icon: `${up}/b.svg`, title: T("Projetos que elevam sua carreira", "Projects that will elevate your career."), text: T("Problemas complexos que aceleram seu aprendizado.", "Complex problems that accelerate your learning.") },
  { icon: `${up}/www.flaticon.com-11-1.svg`, title: T("Equipes de alto nível", "High-level teams"), text: T("Pessoas inteligentes, colaborativas e autônomas ao seu lado.", "Intelligent, collaborative, and autonomous people by your side.") },
  { icon: `${up}/www.flaticon.com-11-2.svg`, title: T("Ambiente de crescimento contínuo", "Environment of continuous growth"), text: T("Aprender, experimentar e evoluir faz parte do dia a dia.", "Learning, experimenting, and evolving are part of everyday life.") },
];

const valores = [
  {
    icon: `${up}/www.flaticon.com-11-3.svg`, title: T("Protagonismo", "Leadership"),
    text: T("Agimos com visão crítica e pensamento estratégico. Questionamos, propomos e assumimos responsabilidade por criar novos caminhos e estratégias.", "We act with critical thinking and strategic vision. We question, propose, and take responsibility for creating new paths and strategies."),
    items: T([
      "Pensar no impacto gerado, não apenas na entrega da tarefa ou no cumprimento do prazo.",
      "Questionar, sugerir e provocar para gerar valor, propondo soluções e caminhos melhores.",
      "Se antecipar às necessidades: identificar oportunidades e agir antes de ser solicitado.",
    ], [
      "Think about the impact generated, not just the delivery of the task or meeting the deadline.",
      "Question, suggest, and provoke in order to generate value, proposing better solutions and paths forward.",
      "Anticipate needs: identify opportunities and act before being asked.",
    ]),
  },
  {
    icon: `${up}/www.flaticon.com-11-4.svg`, title: T("Colaboração", "Collaboration"),
    text: T("Construímos juntos, com respeito, troca e envolvimento real. Colaborar é somar talentos para entregar a melhor experiência para o cliente de dentro ou de fora.", "We build together, with respect, exchange, and genuine engagement. Collaboration means combining talents to deliver the best experience for the customer, both internally and externally."),
    items: T([
      "Agir com respeito às pessoas, às diferenças e às ideias.",
      "Compartilhar o conhecimento, experiências e aprendizados para fortalecer o todo.",
      "Buscar alinhamento, construir consensos e tomar decisões com base no melhor para o time.",
    ], [
      "Act with respect for people, differences, and ideas.",
      "Share knowledge, experiences, and lessons learned to strengthen the whole.",
      "Seek alignment, build consensus, and make decisions based on what is best for the team.",
    ]),
  },
  {
    icon: `${up}/www.flaticon.com-11-6.svg`, title: T("Eficiência", "Efficiency"),
    text: T("Ser eficiente é saber priorizar, usar IA e dados com propósito e transformar inteligência em impacto.", "Being efficient means knowing how to prioritize, using AI and data purposefully, and transforming intelligence into impact."),
    items: T([
      "Não decidir por impulso: usar análise, tecnologia e contexto.",
      "Eliminar a complexidade desnecessária e entregar o essencial com excelência.",
      "Usar IA, automação e ferramentas digitais para escalar resultados não tarefas.",
    ], [
      "Don't make impulsive decisions: use analysis, technology, and context.",
      "Eliminate unnecessary complexity and deliver the essentials with excellence.",
      "Use AI, automation, and digital tools to scale results, not tasks.",
    ]),
  },
  {
    icon: `${up}/www.flaticon.com-11-5.svg`, title: T("Evolução", "Evolution"),
    text: T("Errar faz parte, corrigir rápido também. É assim que evoluímos. Transformamos o desconforto em combustível para avançar.", "Making mistakes is part of the process, and correcting them quickly is too. That's how we evolve. We transform discomfort into fuel to move forward."),
    items: T([
      "Experimentar, prototipar e aplicar aprendizados com agilidade e coragem.",
      "Usar PDI, feedbacks, avaliações de desempenho e conversas diárias como ferramentas reais de crescimento.",
      "Assumir responsabilidade pela própria evolução, buscando aprendizado e colocando em prática de forma contínua.",
    ], [
      "Experiment, prototype, and apply learnings with agility and courage.",
      "Use Individual Development Plans (IDPs), feedback, performance reviews, and daily conversations as real tools for growth.",
      "Take responsibility for your own development, seeking to learn and putting it into practice continuously.",
    ]),
  },
];

const beneficios = [
  ...T([
  { title: "Capacitação Continuada", items: ["Incentivo e investimento em capacitação continuada e certificação profissional", "Benefício Educação Personalizada | Unico Skill", "Feedbacks frequentes e estruturados"] },
  { title: "Saúde e Bem-Estar", items: ["Plano de Saúde Nacional", "Plano Odontológico", "Seguro de Vida", "TotalPass"] },
  { title: "Suporte ao Trabalho", items: ["Equipamento de ponta para Home Office", "Vale Alimentação", "Vale Refeição", "Auxílio Creche"] },
], [
  { title: "Continuing Training", items: ["Incentives and investment in ongoing training and professional certification", "Personalized Education Benefit | Unico Skill", "Frequent and structured feedback"] },
  { title: "Health and Wellness", items: ["National Health Plan", "Dental Plan", "Life Insurance", "TotalPass"] },
  { title: "Work Support", items: ["State-of-the-art equipment for home office", "Food voucher", "Meal voucher", "Childcare assistance"] },
]),
];
---
<BaseLayout title={T("Carreiras", "Careers")} seo={page?.data.seo}>
  <PageHero eyebrow={T("Carreiras", "Careers")} title={T("Por que trabalhar na Vertigo?", "Why work at Vertigo?")} image={metaOf("/carreiras/").heroImage} animate size="display" />

  <section class="section">
    <div class="container">
      <h2 class="lead" data-anim="fadeInUp" data-delay="350">{T("Cresça, gere impacto e construa uma carreira na velocidade da transformação", "Grow, make an impact, and build a career at the speed of transformation.")}</h2>
      <div class="cards two">
        {motivos.map((m) => (
          <article class="card">
            <img class="icon" src={m.icon} alt="" width="48" height="48" loading="lazy" />
            <h3>{m.title}</h3>
            <p>{m.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-light">
    <div class="container">
      <div class="driven">
        <img src={`${up}/vertigo-driven-pg-carreiras.jpeg`} alt="Vertigo Driven" loading="lazy" width="627" height="470" />
        <div>
          <span class="chip chip-blue" data-anim="fadeInUp" data-delay="200">{T("Mentalidade", "Mindset")}</span>
          <h2 class="t-h2">{T("Mentalidade Vertigo Driven", "Vertigo Driven Mindset")}</h2>
          <div data-anim="fadeInUp" data-delay="350">
            {en ? (
              <>
                <p>The Vertigo Driven mindset is about accepting that all transformation is uncomfortable and that's part of the game.</p>
                <p>It's about operating with clarity, intelligence, and speed in highly complex scenarios.</p>
                <p>We are not seeking comfort. We are prepared to evolve continuously, make conscious decisions, and transform challenges into real progress.</p>
                <p>Here, attitude matters more than intention. And culture only makes sense if it takes us forward and to the right place.</p>
              </>
            ) : (
              <>
                <p>Mentalidade Vertigo Driven é assumir que toda transformação é incômoda e isso faz parte do jogo.</p>
                <p>É operar com clareza, inteligência e velocidade em cenários de alta complexidade.</p>
                <p>Não buscamos conforto. Somos preparados para evoluir continuamente, tomar decisões conscientes e transformar desafios em progresso real.</p>
                <p>Aqui, atitude vale mais que intenção. E cultura só faz sentido se nos levar para frente e para o lugar certo.</p>
              </>
            )}
          </div>
        </div>
      </div>
      <div class="cards two values">
        {valores.map((v) => (
          <article class="card">
            <img class="icon" src={v.icon} alt="" width="48" height="48" loading="lazy" />
            <h3>{v.title}</h3>
            <p>{v.text}</p>
            <ul>{v.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="t-section" data-anim="fadeInUp" data-delay="300">{T("Nossos Benefícios", "Our Benefits")}</h2>
      <div class="cards three">
        {beneficios.map((b) => (
          <article class="card">
            <h3 data-anim="fadeInUp" data-delay="300">{b.title}</h3>
            <ul class="checks">{b.items.map((i) => <li><Icon name="check" size={16} />{i}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ImageCta
    tone="gray"
    image={`${up}/vertigo-carreiras.jpeg`}
    eyebrow={T("Trabalhe Conosco", "Work with us")}
    title={T("Vem pra Vertigo!", "Come to Vertigo!")}
    text={T("Ative a Mentalidade Vertigo Driven e construa seu futuro aqui com a gente.", "Activate the Vertigo Driven mindset and build your future here with us.")}
    cta={{ label: T("Confira nossas vagas", "Check out our vacancies"), href: "https://vertigo.inhire.app/vagas" }}
  />
</BaseLayout>

<style>
  .lead { color: var(--vt-blue); text-align: center; font-size: var(--fs-h1); font-weight: 600; line-height: 1.1; letter-spacing: -1px; max-width: 1000px; margin: 0 auto 56px; }
  .cards { display: grid; gap: 32px; }
  .two { grid-template-columns: repeat(2, 1fr); }
  .three { grid-template-columns: repeat(3, 1fr); margin-top: 48px; }
  .card { background: var(--vt-surface); border: 1px solid var(--vt-line); border-radius: 12px; padding: 32px; box-shadow: 0 6px 24px rgb(12 21 87 / .06); }
  .section-light .card { background: var(--vt-white); }
  .icon { width: 48px; height: 48px; margin-bottom: 20px; }
  h3 { color: var(--vt-blue); font-size: 28px; font-weight: 600; line-height: 1.3; letter-spacing: 0; margin: 0 0 10px; }
  .card p { margin: 0; color: #444; font-size: 18px; line-height: 1.33; }
  .card ul { margin: 16px 0 0; padding-left: 1.1em; color: #444; font-size: 16px; }
  .card li { margin: 10px 0; }
  .three h3 { font-size: 20px; font-weight: 500; line-height: 1; margin-bottom: 16px; }
  .checks { list-style: none; padding: 0 !important; }
  .checks li { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; font-weight: 500; line-height: 30px; margin: 0; color: var(--vt-text); }
  .checks :global(svg) { margin-top: 8px !important; }
  @media (max-width: 767px) {
    h3 { font-size: 22px; } .card p { line-height: 1.17; }
    .three h3 { font-size: 24px; } .checks li { font-size: 16px; }
  }
  .checks :global(svg) { color: var(--vt-blue); flex: none; margin-top: 4px; }
  .driven { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; margin-bottom: 64px; }
  .driven img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-bottom-right-radius: var(--vt-radius-card); }
  .driven h2 { margin: 20px 0; color: var(--vt-black); }
  .driven p { font-size: 17px; }
  @media (max-width: 1024px) { .three { grid-template-columns: 1fr; } }
  @media (max-width: 900px) { .two, .driven { grid-template-columns: 1fr; } .driven { gap: 32px; } }
</style>
